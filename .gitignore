# ==============================================================================
# FORGE-VISION — Forensic Platform .gitignore
# ==============================================================================

# Environment & Secret Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
kaggle.json
.kaggle/
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Database & SQLite Storage (Transient / Local Prototype Data)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
db/*.db
db/*.sqlite
db/*.sqlite3

# Large Surveillance Footage, Media & Ephemeral Evidence Stores
data/
data/kaggle/
data/datasets/
data/evidence/
data/recovered/
data/processed/
data/thumbnails/
evidence_store/
evidence_store/files/
evidence_store/thumbnails/
evidence_store/reports/
uploads/

# Video & Large Media Binary Formats
*.mp4
*.avi
*.mkv
*.mov
*.dav
*.webm
*.mpg
*.mpeg
*.m4v
# Video transport streams (exclude media dirs only to preserve TypeScript source files)
data/**/*.ts
evidence_store/**/*.ts
!*.ts
!*.tsx
*.raw
*.bin
*.iso
*.img

# Generated Forensic Reports & PDFs
*.pdf
reports/*.pdf

# Node.js & Next.js Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.next/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
tsconfig.tsbuildinfo

# IDE, OS & Editor Temp Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
*.log
