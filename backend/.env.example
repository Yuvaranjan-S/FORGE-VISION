# ==============================================================================
# FORGE-VISION Backend Environment Variables (.env.example)
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
PORT=8000

# Frontend URL & CORS Configuration
# Set to your Vercel production domain on Render (e.g. https://forge-vision.vercel.app)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Local Prototype default: sqlite:///./db/forensiq.db
# Production PostgreSQL (Optional): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./db/forensiq.db

# Kaggle Dataset Integration Credentials (OPTIONAL)
# Leave blank to use built-in synthetic benchmark generator
KAGGLE_USERNAME=
KAGGLE_KEY=
